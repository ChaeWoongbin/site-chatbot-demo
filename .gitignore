!/backend/app/knowledge_store.py
!/backend/app/rate_limit.py
!/backend/app/main.py
!/examples/
/examples/*
!/examples/desk-lamp.md
!/examples/desk-lamp.ko.md
!/static/
/static/*
!/static/index.html
!/docs/
/docs/*
!/docs/demo-screen.jpg
!/docs/demo-screen-ko.jpg
!/tests/
/tests/*
!/tests/test_demo.py
